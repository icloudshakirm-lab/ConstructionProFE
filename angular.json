{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "constructpro": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "libredwg-parser-worker.js",
                "input": "node_modules/@mlightcad/cad-simple-viewer/dist",
                "output": "/cad-workers"
              },
              {
                "glob": "mtext-renderer-worker.js",
                "input": "node_modules/@mlightcad/cad-simple-viewer/dist",
                "output": "/cad-workers"
              },
              {
                "glob": "dxf-parser-worker.js",
                "input": "node_modules/@mlightcad/data-model/dist",
                "output": "/cad-workers"
              },
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "leaflet-images"
              },
            ],
            "allowedCommonJsDependencies": [
              "@mlightcad/cad-simple-viewer",
              "@mlightcad/data-model",
              "lodash-es",
              "leaflet",
              "leaflet-draw"
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "node_modules/leaflet-draw/dist/leaflet.draw.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "13kB"
                },
                {
                  "type": "any",
                  "maximumWarning": "3mb",
                  "maximumError": "6mb"
                },
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "constructpro:build:production"
            },
            "development": {
              "buildTarget": "constructpro:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
            ],
            "styles": [
              "src/styles.scss"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d922c0d6-130e-40fb-ae0e-96ffe94a4b8e"
  }
}
